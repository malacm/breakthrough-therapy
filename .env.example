# =============================================================================
# BreakThrough Therapy — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================================

# --- Brevo (transactional email for the contact form) ---
# Create a free Brevo account at brevo.com and generate an API key.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=contact@breakthroughtherapy.clinic
BREVO_FROM_NAME=Ian at BreakThrough

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=contact@breakthroughtherapy.clinic
